APP_NAME="IDOIL ENERGY"
APP_ENV=production
APP_KEY=base64:GENERER_AVEC_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://idoil-energy.com

# Domaine pour Traefik
DOMAIN=idoil-energy.com

# Base de données MySQL
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=idoil_energy
DB_DATABASE=idoil_energy
DB_USERNAME=root
DB_PASSWORD=CHANGER_MOT_DE_PASSE_FORT

# Mail via Hostinger SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@idoil-energy.com
MAIL_PASSWORD=VOTRE_MOT_DE_PASSE_HOSTINGER
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=contact@idoil-energy.com
MAIL_FROM_NAME="IDOIL ENERGY"

# Cache / Session
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

LOG_CHANNEL=stack
LOG_LEVEL=error
